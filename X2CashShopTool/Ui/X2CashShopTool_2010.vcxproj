<?xml version="1.0" encoding="utf-8"?>
<!--
  X2CashShopTool - the /clr half. CLRSupport=true + TargetFrameworkVersion=v4.0
  here is exactly the combination that makes Microsoft.CppBuild.targets:733
  stamp /clr:nostdlib onto every ClCompile item in THIS project - see
  CASH_SHOP_TOOL_PLAN.md section 6. That is fine and expected: this project
  is meant to be managed. What must never happen is CLRSupport leaking onto
  X2CashShopCore (../Core/X2CashShopCore_2010.vcxproj) - keep the two
  projects separate, do not merge them "for simplicity".

  Phase 0 is a plain console probe (SubSystem=Console), not the WinForms UI
  yet - that arrives in phase 4+, at which point SubSystem=Windows will need
  EntryPointSymbol=main (see plan section 7) since the default entry point
  for a Windows-subsystem /clr exe is WinMainCRTStartup, not mainCRTStartup.
-->
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{AB38DA16-B358-469D-9DA1-935DAF267AA1}</ProjectGuid>
    <Keyword>ManagedCProj</Keyword>
    <RootNamespace>X2CashShopTool</RootNamespace>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v100</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <CLRSupport>true</CLRSupport>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v100</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <CLRSupport>true</CLRSupport>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'" Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <_ProjectFileVersion>10.0.30319.1</_ProjectFileVersion>
    <OutDir Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">.\Debug\</OutDir>
    <IntDir Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">.\Debug\</IntDir>
    <OutDir Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">.\Release\</OutDir>
    <IntDir Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">.\Release\</IntDir>
    <LinkIncremental Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">true</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">false</LinkIncremental>
    <TargetName>X2CashShopTool</TargetName>
    <!--
      No embedded manifest, on purpose. The separate mt.exe step VS2010 runs
      after linking reopens the freshly written exe for WRITE, and on this
      machine Defender's real-time scan of the new binary holds it long
      enough that mt.exe fails with

        mt.exe : general error c101008d: Failed to write the updated
        manifest to the resource of file ".\Release\X2CashShopTool.exe".
        The process cannot access the file because it is being used by
        another process.

      - reproducibly, after the exe has already linked fine. (Same family as
      the Defender note in CLAUDE.md's "Deploying the offline client".)

      Nothing here needs the manifest: VC10 dropped the side-by-side CRT
      binding VC8/VC9 used, so msvcr100.dll is found by plain DLL search,
      and the requested execution level would have been the default
      asInvoker anyway. Turning the step off removes a build failure that
      has nothing to do with the code.
    -->
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <AdditionalIncludeDirectories>../Core;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;NDEBUG;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <TreatWChar_tAsBuiltInType>true</TreatWChar_tAsBuiltInType>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level3</WarningLevel>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <LargeAddressAware>true</LargeAddressAware>
      <AdditionalLibraryDirectories>../../KTDXLIB;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>luaLib.lib;libxml_mt.lib;zlib.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <TargetMachine>MachineX86</TargetMachine>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <InlineFunctionExpansion>OnlyExplicitInline</InlineFunctionExpansion>
      <AdditionalIncludeDirectories>../Core;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;NDEBUG;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <StringPooling>true</StringPooling>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <TreatWChar_tAsBuiltInType>true</TreatWChar_tAsBuiltInType>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level3</WarningLevel>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <LargeAddressAware>true</LargeAddressAware>
      <AdditionalLibraryDirectories>../../KTDXLIB;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>luaLib.lib;libxml_mt.lib;zlib.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <TargetMachine>MachineX86</TargetMachine>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Main.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="IconWallForm.h" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System" />
    <!--
      Phase 2's exit test is a window, so the WinForms assemblies arrive
      here. The SubSystem stays Console on purpose: a console-subsystem
      /clr exe can still open a Form, and keeping stdout means the icon
      census and the wall are both visible from one run. Flipping to
      SubSystem=Windows (phase 4) is what makes EntryPointSymbol=main
      necessary - see the comment at the top of this file.
    -->
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Project reference, not a raw AdditionalDependencies entry: VC++ links
      a referenced static lib's output automatically, and this is what keeps
      X2CashShopCore's own settings (its absent CLRSupport included) isolated
      in its own project file rather than duplicated here.
    -->
    <ProjectReference Include="..\Core\X2CashShopCore_2010.vcxproj">
      <Project>{130E1179-45D2-4B8B-9E92-32AE20EFCE44}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
